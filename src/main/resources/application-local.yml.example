# 이 파일을 복사해 같은 폴더에 application-local.yml 을 만들고 값을 채워요.
# application-local.yml 은 Git에 올라가지 않아요 (.gitignore).
spring:
  datasource:
    password: 여기에_내_sfaas_app_비밀번호

jwt:
  secret: 여기에_Base64로_인코딩한_32바이트_이상_비밀키   # 예: openssl rand -base64 32

mqtt:
  client-id: sfaas-be-내이름

# AI 계획수정 보고서 (Google Gemini 무료 키, aistudio.google.com 에서 발급). 키가 없으면 템플릿 문장으로 대신 만들어요
ai:
  report:
    api-key: 여기에_내_API_키

# 슬랙 알림 (슬랙 앱 → Incoming Webhooks → Add New Webhook 으로 받은 주소). 없으면 전송 버튼이 "웹훅 미설정" 오류를 보여요
slack:
  webhook-url: https://hooks.slack.com/services/여기에_내_웹훅_경로
  app-base-url: http://여기에_서버_PC_IP   # 슬랙의 "보고서 보기" 버튼이 여는 주소 (같은 공유기 안에서만 열려요)
